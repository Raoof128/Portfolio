# Removed PGP key: force stale bookmarks / edge-cached hits to the current
# security contact instead of the deleted placeholder key (301 also evicts the
# stale cached asset that a plain deploy leaves at this exact path).
/pgp-key.txt  /.well-known/security.txt  301

# Trailing-slash variants of the top-level pages go straight to the canonical path in
# one hop. Without these, /projects/ matched the /projects/* rewrite below and then
# took a second redirect. Exact paths must stay above their /* wildcards.
/about/           /about           308
/contact/         /contact         308
/resume/          /resume          308
/projects/        /projects        308
/lab/             /lab             308
/write-ups/       /write-ups       308
/hall-of-fame/    /hall-of-fame    308
/security-policy/ /security-policy 308
/en/about/           /about           308
/en/contact/         /contact         308
/en/resume/          /resume          308
/en/projects/        /projects        308
/en/lab/             /lab             308
/en/write-ups/       /write-ups       308
/en/hall-of-fame/    /hall-of-fame    308
/en/security-policy/ /security-policy 308

# Redirect authored English aliases with a fixed destination prefix. A generic
# /en/* -> /:splat rule can put //host at the beginning of Location.
# Unpublished root aliases fall through to 404. Queries remain preserved.
/en  /  308
/en/ /  308
/en/about /about 308
/en/about/* /about/:splat 308
/en/contact /contact 308
/en/contact/* /contact/:splat 308
/en/resume /resume 308
/en/resume/* /resume/:splat 308
/en/projects /projects 308
/en/projects/* /projects/:splat 308
/en/lab /lab 308
/en/lab/* /lab/:splat 308
/en/write-ups /write-ups 308
/en/write-ups/* /write-ups/:splat 308
/en/hall-of-fame /hall-of-fame 308
/en/hall-of-fame/* /hall-of-fame/:splat 308
/en/security-policy /security-policy 308
/en/security-policy/* /security-policy/:splat 308

# Non-English locale routes — exact and sub-paths (pass through unchanged)
/fa    /fa    200
/fa/*  /fa/:splat  200
/ar    /ar    200
/ar/*  /ar/:splat  200
/zh    /zh    200
/zh/*  /zh/:splat  200
/es    /es    200
/es/*  /es/:splat  200

# Root-level RSC prefetch files (requested when user is on / and hovers nav links)
/__next._tree.txt                    /en/__next._tree.txt                    200
/__next._full.txt                    /en/__next._full.txt                    200
/__next._head.txt                    /en/__next._head.txt                    200
/__next._index.txt                   /en/__next._index.txt                   200
/__next.$d$locale.__PAGE__.txt       /en/__next.$d$locale.__PAGE__.txt       200
/__next.$d$locale.txt                /en/__next.$d$locale.txt                200

# Full RSC fallback requests use .txt URLs when segment prefetch is unavailable.
# These exact collection names do not match the slash-prefixed wildcards below.
/index.txt            /en.txt                    200
/about.txt            /en/about.txt              200
/contact.txt          /en/contact.txt            200
/resume.txt           /en/resume.txt             200
/projects.txt         /en/projects.txt           200
/lab.txt              /en/lab.txt                200
/write-ups.txt        /en/write-ups.txt          200
/hall-of-fame.txt     /en/hall-of-fame.txt       200
/security-policy.txt  /en/security-policy.txt    200

# English routes — exact match + sub-path wildcard
# The /* rule covers RSC prefetch files (__next._tree.txt etc.) and slugs
/                /en             200
/about           /en/about       200
/about/*         /en/about/:splat      200
/contact         /en/contact     200
/contact/*       /en/contact/:splat    200
/resume          /en/resume      200
/resume/*        /en/resume/:splat     200
/projects        /en/projects    200
/projects/*      /en/projects/:splat   200
/lab             /en/lab         200
/lab/*           /en/lab/:splat        200
/write-ups       /en/write-ups   200
/write-ups/*     /en/write-ups/:splat  200
/hall-of-fame    /en/hall-of-fame      200
/hall-of-fame/*  /en/hall-of-fame/:splat  200
/security-policy     /en/security-policy   200
/security-policy/*   /en/security-policy/:splat  200
