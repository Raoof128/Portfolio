{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:schemas": "node --test scripts/lib/schema-language-audit.test.mjs",
    "test:audit-http": "node --test scripts/lib/production-audit.test.mjs",
    "test:security": "node --test scripts/lib/static-security.test.mjs",
    "audit:security": "node scripts/audit-static-security.mjs",
    "test:backend": "npm run test:audit-http && vitest run src/i18n/index.test.ts src/lib/server-routes.test.tsx src/lib/data.test.ts src/lib/machine-reliability.test.ts src/lib/content-integrity.test.tsx src/lib/version-route.test.ts src/lib/feed-route.test.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "audit:agents": "node scripts/audit-agents.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "test:dependency-security": "node --test scripts/lib/braces-guard.test.mjs"
  },
  "dependencies": {
    "7.css": "0.21.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@researchos/braces-guard": "file:vendor/researchos-braces-guard-0.1.0.tgz",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.7",
    "braces": "$@researchos/braces-guard"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ]
  }
}
